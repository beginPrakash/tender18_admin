# Everything in this folder is included by PHP (from admin/ and admin/api/)
# or run from cron/CLI. None of it should be reachable over the web:
# scripts like */delete_index.php delete a whole Elasticsearch index on a plain GET.
# PHP include/require reads from disk and is not affected by this file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
